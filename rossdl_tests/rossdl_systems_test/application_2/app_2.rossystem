application_2:
  subSystems:
    system_a
  nodes:
    system_b_consumer:
      from: "system_b.consumer"
      interfaces:
        - consumer_image_in: sub-> "consumer::image_in"
        - description_in: sub-> "consumer::description_in"
  connections:
      - [ image_raw, consumer_image_in ]
      - [ description_out, description_in ]
  processes:
    main_process:
      nodes: [system_b_consumer]
      threads: 2 