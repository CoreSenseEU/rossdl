system_a:
  nodes:
    system_a_basic:
      from: "system_a.image_filter"
      interfaces:
        - image_raw: pub-> "image_filter::image_out"
        - image_in: sub-> "image_filter::image_in"
        - description_out: pub-> "image_filter::description_out"
      parameters:
        - DescriptionLabel: "image_filter::description_label"
          value: "image_raw"
  connections:
    - [ image_raw, image_in ]
  processes:
    main_process:
      nodes: [ system_a_basic ]
      threads: 1
